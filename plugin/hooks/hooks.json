{
  "hooks" : {
    "PermissionDenied" : [
      {
        "hooks" : [
          {
            "command" : "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stew hook denied",
            "onFailure" : "continue",
            "timeout" : 1800,
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stew hook permission",
            "onFailure" : "continue",
            "statusMessage" : "Asking in stew",
            "timeout" : 1800,
            "type" : "command"
          }
        ],
        "matcher" : "*"
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stew hook pre",
            "onFailure" : "continue",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : "*"
      },
      {
        "hooks" : [
          {
            "command" : "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stew hook question",
            "onFailure" : "continue",
            "timeout" : 1800,
            "type" : "command"
          }
        ],
        "matcher" : "AskUserQuestion"
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stew hook session-start",
            "onFailure" : "continue",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "async" : true,
            "command" : "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stew hook stop",
            "onFailure" : "continue",
            "timeout" : 15,
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stew hook stop-late",
            "onFailure" : "continue",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ],
    "SubagentStart" : [
      {
        "hooks" : [
          {
            "command" : "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stew hook subagent-start",
            "onFailure" : "continue",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/stew hook prompt",
            "onFailure" : "continue",
            "timeout" : 5,
            "type" : "command"
          }
        ]
      }
    ]
  }
}
